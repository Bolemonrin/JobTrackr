{
    "manifest_version": 3,
    "name": "JobTrackr",
    "version": "1.0",
    "description": "Job Tracking Extension",
    "action": {
        "default_popup": "index.html",
        "default_title": "JobTrackr",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": ["storage", "scripting", "activeTab"],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "host_permissions": [
        "https://script.google.com/*",
        "https://script.googleusercontent.com/*",
        "<all_urls>"
    ],
    "web_accessible_resources": [
        {
            "resources": ["inject.js"],
            "matches": ["<all_urls>"]
        }
    ]
}
