{
    "manifest_version": 3,
    "name": "JobTrackr",
    "version": "1.1.0",
    "key": "",
    "description": "Job Tracking Extension",
    "action": {
        "default_popup": "index.html",
        "default_title": "JobTrackr",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "storage",
        "scripting",
        "activeTab",
        "identity"
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "host_permissions": [
        "https://sheets.googleapis.com/*",
        "https://oauth2.googleapis.com/*",
        "https://accounts.google.com/*",
        "<all_urls>"
    ],
    "web_accessible_resources": [
        {
            "resources": ["inject.js"],
            "matches": ["<all_urls>"]
        }
    ],
    "oauth2": {
        "client_id": "365922151307-3k7jouhtogc5m87np6sca8bvv4kv2ek9.apps.googleusercontent.com",
        "scopes": ["https://www.googleapis.com/auth/userinfo.email"]
    }
}
